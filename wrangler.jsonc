{
  // TERRA 자유곡 보드 — 화면(public/)과 API(src/)를 Worker 하나로 서비스
  "name": "terra-freetrack",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // 임원진 관리 키는 비밀값: `npx wrangler secret put ADMIN_KEY`
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "terra-freetrack",
      // `npx wrangler d1 create terra-freetrack` 결과의 database_id로 바꾸기
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
